import cv2
import torch
import os
import numpy as np
from tkinter import Tk, filedialog, Button
from torchvision import transforms
from PIL import Image

# Load car color classification model
def load_color_model(model_path):
    from torchvision.models import resnet18
    model = resnet18(pretrained=False)
    model.fc = torch.nn.Linear(model.fc.in_features, 6)  # Adjust for your number of color classes
    model.load_state_dict(torch.load(model_path, map_location=torch.device('cpu')))
    model.eval()
    return model

# Predict color from cropped car image
def predict_car_color(model, img):
    transform = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
    ])
    img_tensor = transform(img).unsqueeze(0)
    with torch.no_grad():
        output = model(img_tensor)
        _, predicted = torch.max(output, 1)
    return predicted.item()

# Load pre-trained Haar cascade for car and person detection
car_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + "haarcascade_car.xml")
person_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + "haarcascade_fullbody.xml")

# Color labels (update based on your training)
color_labels = ['black', 'blue', 'green', 'red', 'white', 'yellow']  # Example classes

# Detect cars and people in image
def process_image(img_path, model):
    image = cv2.imread(img_path)
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

    cars = car_cascade.detectMultiScale(gray, 1.1, 3)
    people = person_cascade.detectMultiScale(gray, 1.1, 3)

    car_count = 0
    for (x, y, w, h) in cars:
        car_crop = image[y:y+h, x:x+w]
        car_pil = Image.fromarray(cv2.cvtColor(car_crop, cv2.COLOR_BGR2RGB))
        color_idx = predict_car_color(model, car_pil)
        color_name = color_labels[color_idx]

        if color_name == "blue":
            box_color = (0, 0, 255)  # Red for blue cars
        else:
            box_color = (255, 0, 0)  # Blue for others

        cv2.rectangle(image, (x, y), (x+w, y+h), box_color, 2)
        cv2.putText(image, color_name, (x, y-10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, box_color, 2)
        car_count += 1

    # Draw boxes for people
    for (x, y, w, h) in people:
        cv2.rectangle(image, (x, y), (x+w, y+h), (0, 255, 0), 2)

    # Show counts
    cv2.putText(image, f"Cars Detected: {car_count}", (20, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 255, 255), 2)
    cv2.putText(image, f"People Detected: {len(people)}", (20, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 255, 255), 2)

    cv2.imshow("Detection Result", image)
    cv2.waitKey(0)
    cv2.destroyAllWindows()

# Tkinter GUI to load image
def browse_and_process():
    file_path = filedialog.askopenfilename(filetypes=[("Image Files", "*.jpg *.png *.jpeg")])
    if file_path:
        process_image(file_path, color_model)

# Load model
color_model = load_color_model("car_color_model.pth")  # Update with correct path

# Create GUI
root = Tk()
root.title("Car Colour Detection GUI")
root.geometry("300x100")

btn = Button(root, text="Select Image", command=browse_and_process)
btn.pack(pady=20)

root.mainloop()
